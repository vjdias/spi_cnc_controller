// -----------------------------------------------------------------------------
// Physical Constraints (.cst) - IO_LOC / IO_PORT
// Referencia: UG289E (Gowin EDA Constraint User Guide)
// -----------------------------------------------------------------------------

// Clock e reset (1V8 profile)
IO_LOC  "i_clk"      C8;
IO_PORT "i_clk"      IO_TYPE=LVCMOS18 PULL_MODE=NONE;

IO_LOC  "i_resetn"   F13;
IO_PORT "i_resetn"   IO_TYPE=LVCMOS18 PULL_MODE=UP;

// SPI do Raspberry Pi (caso use level-shifter 1V8)
IO_LOC  "pi_sclk"    A9;
IO_PORT "pi_sclk"    IO_TYPE=LVCMOS18 PULL_MODE=NONE;

IO_LOC  "pi_csn"     G12;
IO_PORT "pi_csn"     IO_TYPE=LVCMOS18 PULL_MODE=UP;

IO_LOC  "pi_mosi"    F14;
IO_PORT "pi_mosi"    IO_TYPE=LVCMOS18 PULL_MODE=NONE;

IO_LOC  "pi_miso"    F16;
IO_PORT "pi_miso"    IO_TYPE=LVCMOS18 PULL_MODE=NONE DRIVE=8 SLEW=SLOW;

// LEDs (exemplo)
// IO_LOC  "leds[0]"  B12;
// IO_PORT "leds[0]"  IO_TYPE=LVCMOS18 DRIVE=8 SLEW=SLOW;
// IO_LOC  "leds[1]"  F15;
// IO_PORT "leds[1]"  IO_TYPE=LVCMOS18 DRIVE=8 SLEW=SLOW;

// TMC5160 (placeholders para STEP/DIR/ENN de cada eixo)
// IO_LOC  "tmc_step_x" ???;
// IO_PORT "tmc_step_x" IO_TYPE=LVCMOS18 DRIVE=8; // reduce ringing via external RC if needed
// IO_LOC  "tmc_dir_x"  ???;
// IO_PORT "tmc_dir_x"  IO_TYPE=LVCMOS18 DRIVE=8;
// IO_LOC  "tmc_enn_x"  ???;
// IO_PORT "tmc_enn_x"  IO_TYPE=LVCMOS18 DRIVE=8;
// IO_LOC  "tmc_step_y" ???;
// IO_PORT "tmc_step_y" IO_TYPE=LVCMOS18 DRIVE=8;
// IO_LOC  "tmc_dir_y"  ???;
// IO_PORT "tmc_dir_y"  IO_TYPE=LVCMOS18 DRIVE=8;
// IO_LOC  "tmc_enn_y"  ???;
// IO_PORT "tmc_enn_y"  IO_TYPE=LVCMOS18 DRIVE=8;
// IO_LOC  "tmc_step_z" ???;
// IO_PORT "tmc_step_z" IO_TYPE=LVCMOS18 DRIVE=8;
// IO_LOC  "tmc_dir_z"  ???;
// IO_PORT "tmc_dir_z"  IO_TYPE=LVCMOS18 DRIVE=8;
// IO_LOC  "tmc_enn_z"  ???;
// IO_PORT "tmc_enn_z"  IO_TYPE=LVCMOS18 DRIVE=8;

// Nota: Se seu hardware usa 3V3 direto (sem level-shifter) conectando ao Raspberry Pi e TMC5160,
// troque IO_TYPE de LVCMOS18 para LVCMOS33 nestes pinos e garanta VCCIO do banco em 3V3.
// Caso mantenha level-shifter para 1V8, deixe LVCMOS18.

// Sensores (placeholders)
// IO_LOC  "i_prox_sensor" ???;
// IO_PORT "i_prox_sensor" IO_TYPE=LVCMOS18 PULL_MODE=UP;
// IO_LOC  "i_estop_btn"   ???;
// IO_PORT "i_estop_btn"   IO_TYPE=LVCMOS18 PULL_MODE=UP;

// Encoder incremental (ABZ) — eixo X (nomes alinhados ao top.sv)
IO_LOC  "i_enc_a_x"  J1;
IO_PORT "i_enc_a_x"  IO_TYPE=LVCMOS18 PULL_MODE=UP;   // GCLKT_5

IO_LOC  "i_enc_b_x"  J3;
IO_PORT "i_enc_b_x"  IO_TYPE=LVCMOS18 PULL_MODE=UP;   // GCLKC_5

IO_LOC  "i_enc_z_x"  H3;
IO_PORT "i_enc_z_x"  IO_TYPE=LVCMOS18 PULL_MODE=UP;

// Encoders adicionais (Y/Z) — ajuste pinos conforme seu esquemático
// Eixo Y
// IO_LOC  "i_enc_a_y"  ???;
// IO_PORT "i_enc_a_y"  IO_TYPE=LVCMOS18 PULL_MODE=UP;   // idealmente pino GCLK
// IO_LOC  "i_enc_b_y"  ???;
// IO_PORT "i_enc_b_y"  IO_TYPE=LVCMOS18 PULL_MODE=UP;   // idealmente pino GCLK
// IO_LOC  "i_enc_z_y"  ???;
// IO_PORT "i_enc_z_y"  IO_TYPE=LVCMOS18 PULL_MODE=UP;

// Eixo Z
// IO_LOC  "i_enc_a_z"  ???;
// IO_PORT "i_enc_a_z"  IO_TYPE=LVCMOS18 PULL_MODE=UP;   // idealmente pino GCLK
// IO_LOC  "i_enc_b_z"  ???;
// IO_PORT "i_enc_b_z"  IO_TYPE=LVCMOS18 PULL_MODE=UP;   // idealmente pino GCLK
// IO_LOC  "i_enc_z_z"  ???;
// IO_PORT "i_enc_z_z"  IO_TYPE=LVCMOS18 PULL_MODE=UP;
