IO_LOC  "pi_csn" T7;
// CSN: ativo-baixo; manter pull-up para estado seguro quando host tri-state.
IO_PORT "pi_csn" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "pi_sclk" R8;
// SCLK: entrada de clock; sem pull para timing mais limpo.
