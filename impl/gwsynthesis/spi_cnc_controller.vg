`pragma protect end_protected
module spi_slave (
  pi_csn_d,
  i_resetn_d,
  rd_en_i,
  i_clk_d,
  pi_sclk_d,
  pi_mosi_d,
  pi_miso,
  irq_o,
  n14_6,
  rdata_o
)
;
input pi_csn_d;
input i_resetn_d;
input rd_en_i;
input i_clk_d;
input pi_sclk_d;
input pi_mosi_d;
output pi_miso;
output irq_o;
output n14_6;
output [7:0] rdata_o;
wire miso_from_core;
wire VCC;
wire GND;
  TBUF u_miso_buf (
