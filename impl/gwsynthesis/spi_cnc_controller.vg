module spi_rx_slave_service (
  i_clk_d,
  n1401_6,
  spi_irq,
  spi_rdata,
  spi_rd_en,
  rx_byte_valid,
  rx_byte
)
;
input i_clk_d;
input n1401_6;
input spi_irq;
input [7:0] spi_rdata;
output spi_rd_en;
output rx_byte_valid;
output [7:0] rx_byte;
wire n17_9;
wire n16_17;
wire n16_20;
wire n15_16;
wire [1:0] state;
wire VCC;
wire GND;
  LUT2 n17_s5 (
    .F(n17_9),
    .I0(state[0]),
    .I1(state[1]) 
);
defparam n17_s5.INIT=4'h4;
  LUT2 n16_s11 (
    .F(n16_17),
    .I0(state[0]),
    .I1(spi_irq) 
);
defparam n16_s11.INIT=4'h4;
  LUT2 n16_s13 (
    .F(n16_20),
    .I0(state[0]),
    .I1(spi_irq) 
);
defparam n16_s13.INIT=4'h4;
  LUT2 n15_s9 (
    .F(n15_16),
    .I0(state[1]),
    .I1(state[0]) 
);
defparam n15_s9.INIT=4'h4;
  DFFC rd_en_s0 (
    .Q(spi_rd_en),
    .D(n16_17),
    .CLK(i_clk_d),
    .CLEAR(n1401_6) 
);
  DFFC spi_byte_valid_s0 (
    .Q(rx_byte_valid),
    .D(n17_9),
    .CLK(i_clk_d),
    .CLEAR(n1401_6) 
);
  DFFCE spi_byte_7_s0 (
    .Q(rx_byte[7]),
    .D(spi_rdata[7]),
    .CLK(i_clk_d),
    .CE(n17_9),
    .CLEAR(n1401_6) 
);
  DFFCE spi_byte_6_s0 (
    .Q(rx_byte[6]),
    .D(spi_rdata[6]),
    .CLK(i_clk_d),
    .CE(n17_9),
    .CLEAR(n1401_6) 
);
  DFFCE spi_byte_5_s0 (
    .Q(rx_byte[5]),
    .D(spi_rdata[5]),
    .CLK(i_clk_d),
    .CE(n17_9),
    .CLEAR(n1401_6) 
);
  DFFCE spi_byte_4_s0 (
    .Q(rx_byte[4]),
    .D(spi_rdata[4]),
    .CLK(i_clk_d),
    .CE(n17_9),
    .CLEAR(n1401_6) 
);
  DFFCE spi_byte_3_s0 (
