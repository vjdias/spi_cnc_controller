`pragma protect end_protected
module spi_slave (
  pi_csn_d,
  bus_wr_en_d,
  i_resetn_d,
  bus_rd_en_d,
  i_clk_d,
  pi_sclk_d,
  pi_mosi_d,
  bus_raddr_d,
  bus_waddr_d,
  bus_wdata_d,
  pi_miso,
  spi_irq_d,
  bus_rdata_d
)
;
input pi_csn_d;
input bus_wr_en_d;
input i_resetn_d;
input bus_rd_en_d;
input i_clk_d;
input pi_sclk_d;
input pi_mosi_d;
input [2:0] bus_raddr_d;
input [2:0] bus_waddr_d;
input [7:0] bus_wdata_d;
output pi_miso;
output spi_irq_d;
output [7:0] bus_rdata_d;
wire miso_from_core;
wire VCC;
wire GND;
  TBUF u_miso_buf (
    .O(pi_miso),
    .I(miso_from_core),
    .OEN(pi_csn_d) 
);
  \~spi_master.SPI_MASTER_Top  u_spi_slave_core (
    .bus_wr_en_d(bus_wr_en_d),
    .i_resetn_d(i_resetn_d),
    .bus_rd_en_d(bus_rd_en_d),
    .pi_csn_d(pi_csn_d),
    .i_clk_d(i_clk_d),
    .pi_sclk_d(pi_sclk_d),
    .pi_mosi_d(pi_mosi_d),
    .bus_raddr_d(bus_raddr_d[2:0]),
    .bus_waddr_d(bus_waddr_d[2:0]),
    .bus_wdata_d(bus_wdata_d[7:0]),
    .spi_irq_d(spi_irq_d),
    .miso_from_core(miso_from_core),
    .bus_rdata_d(bus_rdata_d[7:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* spi_slave */
module top (
  i_clk,
  i_resetn,
  pi_sclk,
  pi_csn,
  pi_mosi,
  pi_miso,
  bus_wr_en,
  bus_waddr,
  bus_wdata,
  bus_rd_en,
  bus_raddr,
  bus_rdata,
  spi_irq
)
;
input i_clk;
input i_resetn;
input pi_sclk;
input pi_csn;
input pi_mosi;
output pi_miso;
input bus_wr_en;
input [2:0] bus_waddr;
input [7:0] bus_wdata;
input bus_rd_en;
input [2:0] bus_raddr;
output [7:0] bus_rdata;
output spi_irq;
wire i_clk_d;
wire i_resetn_d;
wire pi_sclk_d;
wire pi_csn_d;
wire pi_mosi_d;
wire bus_wr_en_d;
wire bus_rd_en_d;
wire spi_irq_d;
wire [2:0] bus_waddr_d;
wire [7:0] bus_wdata_d;
wire [2:0] bus_raddr_d;
wire [7:0] bus_rdata_d;
wire VCC;
wire GND;
  IBUF i_clk_ibuf (
    .O(i_clk_d),
    .I(i_clk) 
);
  IBUF i_resetn_ibuf (
    .O(i_resetn_d),
    .I(i_resetn) 
);
  IBUF pi_sclk_ibuf (
    .O(pi_sclk_d),
    .I(pi_sclk) 
);
  IBUF pi_csn_ibuf (
    .O(pi_csn_d),
    .I(pi_csn) 
);
  IBUF pi_mosi_ibuf (
    .O(pi_mosi_d),
    .I(pi_mosi) 
);
  IBUF bus_wr_en_ibuf (
    .O(bus_wr_en_d),
    .I(bus_wr_en) 
);
  IBUF bus_waddr_0_ibuf (
    .O(bus_waddr_d[0]),
    .I(bus_waddr[0]) 
);
  IBUF bus_waddr_1_ibuf (
    .O(bus_waddr_d[1]),
    .I(bus_waddr[1]) 
);
