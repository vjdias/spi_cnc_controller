`pragma protect end_protected
module spi_slave (
  pi_csn_d,
  i_resetn_d,
  rd_en_i,
  i_clk_d,
  pi_sclk_d,
  pi_mosi_d,
  pi_miso,
  spi_irq_d,
  n14_6,
  bus_rdata_d
)
;
input pi_csn_d;
input i_resetn_d;
input rd_en_i;
input i_clk_d;
input pi_sclk_d;
input pi_mosi_d;
output pi_miso;
output spi_irq_d;
output n14_6;
output [7:0] bus_rdata_d;
wire miso_from_core;
wire VCC;
wire GND;
  TBUF u_miso_buf (
    .O(pi_miso),
    .I(miso_from_core),
    .OEN(pi_csn_d) 
);
  \~spi_master.SPI_MASTER_Top  u_spi_slave_core (
    .i_resetn_d(i_resetn_d),
    .rd_en_i(rd_en_i),
    .pi_csn_d(pi_csn_d),
    .i_clk_d(i_clk_d),
    .pi_sclk_d(pi_sclk_d),
    .pi_mosi_d(pi_mosi_d),
    .spi_irq_d(spi_irq_d),
    .miso_from_core(miso_from_core),
    .n14_6(n14_6),
    .bus_rdata_d(bus_rdata_d[7:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
