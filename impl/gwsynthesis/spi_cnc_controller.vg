`pragma protect end_protected
module spi_slave (
  pi_csn_d,
  i_resetn_d,
  rd_en_i,
  i_clk_d,
  pi_sclk_d,
  pi_mosi_d,
  pi_miso,
  spi_irq_d,
  n14_6,
  bus_rdata_d
)
;
input pi_csn_d;
input i_resetn_d;
input rd_en_i;
input i_clk_d;
input pi_sclk_d;
input pi_mosi_d;
output pi_miso;
output spi_irq_d;
output n14_6;
output [7:0] bus_rdata_d;
wire miso_from_core;
wire VCC;
wire GND;
  TBUF u_miso_buf (
    .O(pi_miso),
    .I(miso_from_core),
    .OEN(pi_csn_d) 
);
