module gw_gao (
  tms_pad_i,
  tck_pad_i,
  tdi_pad_i,
  i_clk_d,
  pi_miso_in,
  pi_mosi_d,
  pi_sclk_d,
  leds_d,
  tdo_pad_o
)
;
input tms_pad_i;
input tck_pad_i;
input tdi_pad_i;
